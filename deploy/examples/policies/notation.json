{
  "notation": {
    "missingPolicy": "deny",
    "verificationLevel": "strict",
    "revocationMode": "soft",
    "trustStores": [
      {
        "name": "acme-ca",
        "type": "ca",
        "certificates": ["/etc/notation/certs/acme-ca.pem"]
      }
    ],
    "trustPolicy": [
      {
        "name": "default",
        "registryScopes": ["*"],
        "trustStores": ["ca:acme-ca"],
        "trustedIdentities": ["*"]
      }
    ]
  },
  "slsa": {
    "missingPolicy": "allow"
  },
  "vex": {
    "missingPolicy": "allow"
  }
}
