{
  "trust": {
    "issuers": ["https://token.actions.githubusercontent.com"],
    "sanPatterns": ["https://github.com/myorg/**"],
    "sources": ["https://github.com/myorg/*"]
  },
  "exclude": [
    "registry.k8s.io/cloud-provider-gcp/cloud-controller-manager*",
    "registry.k8s.io/cloud-provider-gcp/gcp-compute-persistent-disk-csi-driver*",
    "registry.k8s.io/coredns/**",
    "registry.k8s.io/dns/**",
    "registry.k8s.io/etcd*",
    "registry.k8s.io/kas-network-proxy/**",
    "registry.k8s.io/kube-apiserver*",
    "registry.k8s.io/kube-controller-manager*",
    "registry.k8s.io/kube-proxy*",
    "registry.k8s.io/kube-scheduler*",
    "registry.k8s.io/pause*",
    "registry.k8s.io/provider-aws/aws-ebs-csi-driver*",
    "registry.k8s.io/provider-aws/cloud-controller-manager*",
    "registry.k8s.io/provider-os/cinder-csi-plugin*",
    "registry.k8s.io/provider-os/openstack-cloud-controller-manager*",
    "registry.k8s.io/sig-storage/**"
  ],
  "slsa": { "missingPolicy": "deny" },
  "rules": [
    {
      "images": ["registry.k8s.io/security-profiles-operator/**"],
      "trust": {
        "issuers": ["https://accounts.google.com"],
        "sanPatterns": [
          "krel-trust@k8s-releng-prod.iam.gserviceaccount.com",
          "promoter-summaries@k8s-releng-prod.iam.gserviceaccount.com"
        ],
        "verifiers": [
          {
            "id": "https://k8s.io/promo-tools/verifier/v1",
            "identities": [
              {
                "issuer": "https://accounts.google.com",
                "sanPattern": "promoter-summaries@k8s-releng-prod.iam.gserviceaccount.com"
              }
            ]
          }
        ]
      },
      "vsa": { "missingPolicy": "deny", "minimumLevel": 1 }
    }
  ]
}
