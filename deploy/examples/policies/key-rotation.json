{
  "trust": {
    "verifiers": [
      {
        "id": "build-signer",
        "keys": [
          "/etc/nri-supply-chain/keys/cosign-old.pub",
          "/etc/nri-supply-chain/keys/cosign-new.pub"
        ]
      }
    ]
  },
  "slsa": {
    "missingPolicy": "deny"
  },
  "vex": {
    "missingPolicy": "allow"
  },
  "signatures": {
    "requireTransparencyLog": false
  }
}
