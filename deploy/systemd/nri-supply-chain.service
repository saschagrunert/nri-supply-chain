[Unit]
Description=NRI Supply Chain Verification Plugin
Documentation=https://github.com/saschagrunert/nri-supply-chain
After=crio.service containerd.service network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nri-supply-chain --config /etc/nri-supply-chain/config.toml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
MemoryMax=512M
TasksMax=64
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# /var/cache/nri-supply-chain holds the Sigstore TUF cache (under $HOME) and
# /var/lib/nri-supply-chain the offline attestation store
# (offline.attestation_store defaults to /var/lib/nri-supply-chain/bundles).
CacheDirectory=nri-supply-chain
StateDirectory=nri-supply-chain
Environment=HOME=/var/cache/nri-supply-chain
ReadWritePaths=/var/run/nri
ReadOnlyPaths=/etc/nri-supply-chain
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
